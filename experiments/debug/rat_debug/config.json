{
  "seed": 42,
  "device": "cpu",
  "output_dir": "experiments/debug/rat_debug",
  "data": {
    "dataset": "synthetic",
    "root": "data/samples/synthetic",
    "processed_dir": "data/processed/synthetic",
    "include_train_others": true,
    "train_fraction": 1.0,
    "max_word_pieces": 8,
    "max_element_pieces": 16
  },
  "preprocess": {
    "linking": {
      "max_ngram": 5,
      "max_vpm_per_token": 3,
      "value_linking": true,
      "max_values_per_column": 5000
    },
    "values": {
      "max_ngram": 4,
      "max_db_values": 30,
      "max_candidates": 128
    },
    "validation": {
      "fraction": 0.0,
      "seed": 0
    }
  },
  "relations": {
    "vocab": "full",
    "qq_max_dist": 2,
    "link_ngram": true,
    "link_value": true,
    "link_numbers": true,
    "use_foreign_keys": true
  },
  "model": {
    "encoder": {
      "type": "bert",
      "pretrained_model": "google/bert_uncased_L-2_H-128_A-2",
      "max_length": 512,
      "pooling": "mean",
      "column_type_prefix": true,
      "freeze": false
    },
    "rat": {
      "d_model": 128,
      "num_layers": 2,
      "num_heads": 4,
      "ff_dim": 256,
      "dropout": 0.1,
      "use_relations": true,
      "norm": "pre",
      "share_relation_embeddings": false
    },
    "decoder": {
      "hidden": 128,
      "action_dim": 64,
      "type_dim": 32,
      "att_heads": 4,
      "dropout": 0.2,
      "pointer": "memory_aligned",
      "pointer_dim": 128,
      "grammar_mask": true
    }
  },
  "train": {
    "epochs": 40,
    "batch_size": 16,
    "grad_accum": 1,
    "max_tokens": 400000,
    "lr": 0.001,
    "bert_lr": 0.0001,
    "weight_decay": 0.0,
    "warmup_ratio": 0.05,
    "lr_power": 1.0,
    "clip_grad": 1.0,
    "amp": true,
    "eval_every": 5,
    "eval_batch_size": 32,
    "patience": 0,
    "select_metric": "val_em",
    "log_every": 20
  },
  "eval": {
    "beam_size": 1,
    "max_steps": 250,
    "exec_timeout": 5.0
  },
  "_meta": {
    "config_path": "configs\\debug.yaml"
  }
}